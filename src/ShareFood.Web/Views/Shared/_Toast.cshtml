@{
    var toast = TempData.GetToast();
}

@if (toast is not null)
{
    <div class="toast-container share-toast-container position-fixed end-0 p-3">
        <div class="toast share-toast align-items-center border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body @toast.CssClass rounded-4 px-4 py-3">
                    <strong class="d-block mb-1">@toast.Title</strong>
                    <span>@toast.Message</span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
            </div>
        </div>
    </div>
}
