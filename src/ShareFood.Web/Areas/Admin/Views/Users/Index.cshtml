@model IReadOnlyList<UserAdminListItemViewModel>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div>
            <span class="section-heading__eyebrow">Thành viên hệ thống</span>
            <h1>Người dùng</h1>
        </div>
    </div>

    <form method="get" class="search-bar mb-4">
        <input type="text" name="keyword" value="@ViewData["Keyword"]" class="form-control" placeholder="Tìm theo tên hoặc email" />
        <button type="submit" class="btn btn-brand-outline">Tìm kiếm</button>
    </form>

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Xác nhận email</th>
                        <th>Công thức</th>
                        <th>Trạng thái</th>
                        <th>Ngày tham gia</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge @(item.EmailConfirmed ? "text-bg-success" : "text-bg-warning")">
                                    @(item.EmailConfirmed ? "Đã xác nhận" : "Chưa xác nhận")
                                </span>
                            </td>
                            <td>@item.RecipeCount</td>
                            <td>
                                <span class="badge @(item.IsLocked ? "text-bg-danger" : "text-bg-success")">
                                    @(item.IsLocked ? "Đang bị khóa" : "Hoạt động")
                                </span>
                            </td>
                            <td>@item.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <form asp-action="ToggleLock" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsLocked ? "btn-light" : "btn-outline-danger")">
                                        @(item.IsLocked ? "Mở khóa" : "Khóa tài khoản")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
