@model CreateUserViewModel

<section class="admin-page">
    <div class="admin-page__header">
        <div>
            <span class="section-heading__eyebrow">Người dùng</span>
            <h1>Thêm người dùng mới</h1>
        </div>
        <a class="btn btn-brand-outline" asp-action="Index">Quay lại danh sách</a>
    </div>

    <div class="admin-card admin-card--form">
        <partial name="_ValidationSummary" />
        <form method="post" class="row g-4">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control form-control-lg" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="Model.Roles" class="form-select form-select-lg"></select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="EmailConfirmed" class="form-check-input" />
                    <label asp-for="EmailConfirmed" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12 d-flex gap-3 flex-wrap">
                <button type="submit" class="btn btn-brand">Lưu người dùng</button>
                <a class="btn btn-light" asp-action="Index">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
