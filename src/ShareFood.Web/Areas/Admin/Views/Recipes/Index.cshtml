@model IReadOnlyList<AdminRecipeListItemViewModel>
@{
    ViewData["Title"] = "Quản lý công thức";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div>
            <span class="section-heading__eyebrow">Quản trị nội dung</span>
            <h1>Công thức</h1>
        </div>
    </div>

    <form method="get" class="search-bar mb-4">
        <input type="text" name="keyword" value="@ViewData["Keyword"]" class="form-control" placeholder="Tìm theo tên công thức hoặc tác giả" />
        <button type="submit" class="btn btn-brand-outline">Tìm kiếm</button>
    </form>

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên công thức</th>
                        <th>Danh mục</th>
                        <th>Tác giả</th>
                        <th>Trạng thái</th>
                        <th>Ngày đăng</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.CategoryName</td>
                            <td>@item.AuthorName</td>
                            <td>
                                <span class="badge @(item.IsVisible ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsVisible ? "Đang hiển thị" : "Đang ẩn")
                                </span>
                            </td>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <form asp-action="ToggleVisibility" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light">
                                        @(item.IsVisible ? "Ẩn" : "Hiện")
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa công thức này?');">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
