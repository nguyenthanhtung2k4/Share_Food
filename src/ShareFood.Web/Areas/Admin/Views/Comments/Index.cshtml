@model IReadOnlyList<AdminCommentListItemViewModel>
@{
    ViewData["Title"] = "Quản lý bình luận";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div>
            <span class="section-heading__eyebrow">Kiểm soát nội dung</span>
            <h1>Bình luận</h1>
        </div>
    </div>

    <form method="get" class="search-bar mb-4">
        <input type="text" name="keyword" value="@ViewData["Keyword"]" class="form-control" placeholder="Tìm theo nội dung hoặc tên công thức" />
        <button type="submit" class="btn btn-brand-outline">Tìm kiếm</button>
    </form>

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Công thức</th>
                        <th>Người bình luận</th>
                        <th>Nội dung</th>
                        <th>Thời gian</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-area="Client" asp-controller="Recipes" asp-action="Details" asp-route-id="@item.RecipeId" asp-route-slug="@item.RecipeSlug" target="_blank">
                                    @item.RecipeTitle
                                </a>
                            </td>
                            <td>@item.UserName</td>
                            <td>@item.Content</td>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa bình luận này?');">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
