@model IReadOnlyList<Unit>
@{
    ViewData["Title"] = "Đơn vị đo";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div>
            <span class="section-heading__eyebrow">Quản trị dữ liệu</span>
            <h1>Đơn vị đo</h1>
        </div>
        <a class="btn btn-brand" asp-action="Create">Thêm đơn vị đo</a>
    </div>

    <form method="get" class="search-bar mb-4">
        <input type="text" name="keyword" value="@ViewData["Keyword"]" class="form-control" placeholder="Tìm theo tên hoặc ký hiệu" />
        <button type="submit" class="btn btn-brand-outline">Tìm kiếm</button>
    </form>

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên đơn vị</th>
                        <th>Ký hiệu</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Symbol</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa đơn vị đo này?');">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
