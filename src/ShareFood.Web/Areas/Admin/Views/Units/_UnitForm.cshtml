@model UnitFormViewModel
@{
    var isEdit = Model.Id.HasValue;
}

<section class="admin-page">
    <div class="admin-page__header">
        <div>
            <span class="section-heading__eyebrow">Đơn vị đo</span>
            <h1>@(isEdit ? "Chỉnh sửa đơn vị đo" : "Thêm đơn vị đo")</h1>
        </div>
        <a class="btn btn-brand-outline" asp-action="Index">Quay lại danh sách</a>
    </div>

    <div class="admin-card admin-card--form">
        <partial name="_ValidationSummary" />
        <form method="post" class="row g-4">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Symbol" class="form-label"></label>
                <input asp-for="Symbol" class="form-control form-control-lg" />
                <span asp-validation-for="Symbol" class="text-danger small"></span>
            </div>
            <div class="col-12 d-flex gap-3">
                <button type="submit" class="btn btn-brand">Lưu đơn vị đo</button>
                <a class="btn btn-light" asp-action="Index">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
