@model VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác nhận OTP";
}

<section class="auth-panel">
    <div class="auth-panel__intro">
        <span class="section-heading__eyebrow">Bảo mật email</span>
        <h1>Nhập mã OTP đã gửi về email</h1>
        <p>Chúng tôi đã gửi mã gồm 6 chữ số tới <strong>@Model.Email</strong>. Mã có hiệu lực trong 10 phút.</p>
    </div>

    <div class="auth-card">
        <partial name="_ValidationSummary" />
        <form asp-action="VerifyOtp" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <div class="col-12">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control form-control-lg otp-input" inputmode="numeric" maxlength="6" placeholder="Ví dụ: 123456" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="col-12 d-grid">
                <button type="submit" class="btn btn-brand btn-lg">Xác nhận mã OTP</button>
            </div>
        </form>

        <form asp-action="ResendOtp" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <button type="submit" class="btn btn-brand-outline w-100">Gửi lại mã OTP</button>
        </form>

        <div class="auth-card__footer">
            <span>Đã nhớ mật khẩu?</span>
            <a asp-action="Login">Đăng nhập</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
