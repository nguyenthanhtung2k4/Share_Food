@model IReadOnlyList<RecipeCardViewModel>
@{
    ViewData["Title"] = "Yêu thích";
}

<section class="section-space">
    <div class="section-heading">
        <div>
            <span class="section-heading__eyebrow">Bộ sưu tập của bạn</span>
            <h1>Công thức yêu thích</h1>
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Count == 0)
        {
            <div class="col-12">
                <div class="empty-panel">
                    <h3>Bạn chưa lưu công thức nào</h3>
                    <p>Hãy khám phá thêm món ngon và lưu lại những công thức bạn muốn nấu thử.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <partial name="_RecipeCard" model="item" />
                </div>
            }
        }
    </div>
</section>
